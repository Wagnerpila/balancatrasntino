{
  "manifest_version": 3,
  "name": "Balança Transtino — Avisos no WhatsApp",
  "version": "2.1",
  "description": "Envia pelo WhatsApp Web os avisos do sistema de pesagem (caminhão entrou na balança, ticket da pesagem).",
  "permissions": ["alarms"],
  "host_permissions": ["http://127.0.0.1:8090/*", "https://web.whatsapp.com/*"],
  "background": {"service_worker": "fundo.js"},
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["pagina.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["whatsapp.js"],
      "run_at": "document_idle"
    }
  ]
}
